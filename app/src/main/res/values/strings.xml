    <!-- Measurements: metrics -->
    <string name="metric_weight">Weight</string>
    <string name="metric_weight_instructions">Weigh yourself first thing in the morning, after using the bathroom and before eating or drinking. Wear minimal clothing for consistency.</string>
    <string name="metric_body_fat">Body Fat</string>
    <string name="metric_body_fat_instructions">Use the same method every time: smart scale, calipers, or DEXA. Measure under consistent conditions (e.g. fasted, morning).</string>
    <string name="metric_caloric_intake">Caloric Intake</string>
    <string name="metric_caloric_intake_instructions">Log the total calories you consumed over the day. Track at the same time each day for consistent comparisons.</string>
    <string name="metric_neck">Neck</string>
    <string name="metric_neck_instructions">Stand relaxed with your head straight. Measure around the middle of the neck, just below the Adam\'s apple. Tape should be snug, not tight.</string>
    <string name="metric_shoulders">Shoulders</string>
    <string name="metric_shoulders_instructions">Stand relaxed with arms at your sides. Wrap the tape around the widest part of your shoulders / deltoids, keeping the tape level.</string>
    <string name="metric_chest">Chest</string>
    <string name="metric_chest_instructions">Stand relaxed and breathe normally. Wrap the tape around the chest at nipple level, keeping it horizontal across the back.</string>
    <string name="metric_left_bicep">Left Bicep</string>
    <string name="metric_left_bicep_instructions">Flex your left arm at 90°. Measure around the largest part of the biceps, keeping the tape perpendicular to the arm.</string>
    <string name="metric_right_bicep">Right Bicep</string>
    <string name="metric_right_bicep_instructions">Flex your right arm at 90°. Measure around the largest part of the biceps, keeping the tape perpendicular to the arm.</string>
    <string name="metric_left_forearm">Left Forearm</string>
    <string name="metric_left_forearm_instructions">Let your left arm hang at your side, palm facing forward. Measure around the widest point of the forearm below the elbow.</string>
    <string name="metric_right_forearm">Right Forearm</string>
    <string name="metric_right_forearm_instructions">Let your right arm hang at your side, palm facing forward. Measure around the widest point of the forearm below the elbow.</string>
    <string name="metric_upper_abs">Upper Abs</string>
    <string name="metric_upper_abs_instructions">Stand relaxed and exhale normally. Wrap the tape just below the chest, around the upper abdomen. Keep the tape level.</string>
    <string name="metric_waist">Waist</string>
    <string name="metric_waist_instructions">Stand relaxed and exhale normally. Measure around the narrowest part of the waist, usually around the navel. Do not suck in.</string>
    <string name="metric_lower_abs">Lower Abs</string>
    <string name="metric_lower_abs_instructions">Stand relaxed and exhale normally. Measure around the lower abdomen, roughly two finger-widths below the navel.</string>
    <string name="metric_hips">Hips</string>
    <string name="metric_hips_instructions">Stand with feet together. Measure around the widest part of the hips / glutes. Keep the tape level all the way around.</string>
    <string name="metric_left_thigh">Left Thigh</string>
    <string name="metric_left_thigh_instructions">Stand with weight evenly distributed. Measure around the largest part of the left thigh, just below the glute.</string>
    <string name="metric_right_thigh">Right Thigh</string>
    <string name="metric_right_thigh_instructions">Stand with weight evenly distributed. Measure around the largest part of the right thigh, just below the glute.</string>
    <string name="metric_left_calf">Left Calf</string>
    <string name="metric_left_calf_instructions">Stand relaxed. Measure around the widest part of the left calf, keeping the tape perpendicular to the leg.</string>
    <string name="metric_right_calf">Right Calf</string>
    <string name="metric_right_calf_instructions">Stand relaxed. Measure around the widest part of the right calf, keeping the tape perpendicular to the leg.</string>

    <!-- Caliper skinfold sites -->
    <string name="skinfold_chest">Chest</string>
    <string name="skinfold_chest_instruction">Diagonal fold, halfway between the front armpit crease and the nipple (men) or one-third of the way (women).</string>
    <string name="skinfold_abdomen">Abdomen</string>
    <string name="skinfold_abdomen_instruction">Vertical fold about 2 cm to the right of the navel.</string>
    <string name="skinfold_thigh">Thigh</string>
    <string name="skinfold_thigh_instruction">Vertical fold on the front of the thigh, midway between the hip crease and the top of the kneecap.</string>
    <string name="skinfold_triceps">Triceps</string>
    <string name="skinfold_triceps_instruction">Vertical fold on the back of the upper arm, midway between the shoulder and elbow, arm relaxed.</string>
    <string name="skinfold_suprailiac">Suprailiac</string>
    <string name="skinfold_suprailiac_instruction">Diagonal fold just above the hip bone, following the natural angle of the iliac crest.</string>
    <string name="skinfold_midaxillary">Midaxillary</string>
    <string name="skinfold_midaxillary_instruction">Vertical fold on the midline of the side of the torso, level with the bottom of the sternum.</string>
    <string name="skinfold_subscapular">Subscapular</string>
    <string name="skinfold_subscapular_instruction">Diagonal fold just below the bottom tip of the shoulder blade.</string>
    <string name="skinfold_biceps">Biceps</string>
    <string name="skinfold_biceps_instruction">Vertical fold on the front of the upper arm, midway between the shoulder and elbow, arm relaxed.</string>

